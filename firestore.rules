rules_version = '2';
// Reglas de seguridad del elenco DFUN 90 años.
// Leen: cuentas @unal.edu.co verificadas. Escriben: solo los maestros listados abajo.
service cloud.firestore {
  match /databases/{db}/documents {
    function unal() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@unal[.]edu[.]co$');
    }
    // Deben coincidir con ADMINS y MAESTROS en public/js/config.js.
    function admin() {
      return unal() && request.auth.token.email.lower() in ['hyate@unal.edu.co'];
    }
    function maestro() {
      return admin() || (unal() && request.auth.token.email.lower() in ['bsilvab@unal.edu.co']);
    }
    match /personas/{id} {
      allow read: if unal();
      allow create, update: if maestro();
      allow delete: if admin();
    }
    match /elenco/{id} {
      allow read: if unal();
      allow delete: if maestro();
      allow create, update: if maestro()
        && request.resource.data.danzas is list
        && request.resource.data.danzas.size() <= 11;
    }
    match /config/{doc} {
      allow read: if unal();
      allow write: if maestro();
    }
  }
}
